"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" JMwill's Lightweight & Robust Vim Configuration
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

" => 基础常规设置
set history=1000
filetype plugin indent on
set autoread
let mapleader=","

" => 用户界面
set scrolloff=7
set wildmenu
set number
set relativenumber
set ruler
set showmatch
set hlsearch
set incsearch
set ignorecase
set smartcase
set cursorline
set laststatus=2
set showcmd
set title
set shortmess=atI
set noerrorbells
set novisualbell
set t_vb=
set tm=500

" => 主题、高亮与字体
syntax enable
set t_Co=256
set encoding=utf8

try
  let g:badwolf_darkgutter = 1
  colorscheme badwolf
catch
  try
    colorscheme solarized
  catch
  endtry
endtry

" 软换行与缩进设置 (2空格缩进标准)
set wrap linebreak nolist
set softtabstop=2
set tabstop=2
set shiftwidth=2
set autoindent
set expandtab

" => 系统与剪贴板设置
if has("clipboard")
  set clipboard=unnamed
  if has("unnamedplus")
    set clipboard+=unnamedplus
  endif
endif

set mouse=a
set nostartofline
set ffs=unix,dos

" => 文件备份与跨会话持久撤销 (自动建目录，永不报错)
let s:undo_dir = expand('~/.vim/undo')
let s:backup_dir = expand('~/.vim/backups')
let s:swap_dir = expand('~/.vim/swaps')

if !isdirectory(s:undo_dir)   | call mkdir(s:undo_dir, 'p')   | endif
if !isdirectory(s:backup_dir) | call mkdir(s:backup_dir, 'p') | endif
if !isdirectory(s:swap_dir)   | call mkdir(s:swap_dir, 'p')   | endif

set undodir=~/.vim/undo
set backupdir=~/.vim/backups
set directory=~/.vim/swaps
set undofile
set undolevels=1000

" => 实用快捷键绑定
" 快速保存
nmap <leader>w :w!<cr>

" 切换当前工作目录
nnoremap <leader>cd :cd %:p:h<CR>
nnoremap <leader>lcd :lcd %:p:h<CR>

" 空格键快速折叠/展开代码
nnoremap <space> za

" 双手不离主键盘区快速退出编辑模式
inoremap kj <ESC>

" 清理多余高亮
nnoremap <leader>/ :nohlsearch<CR>

" 按视觉行上下移动
nnoremap j gj
nnoremap k gk

" 窗口间流畅跳转
map <C-j> <C-W>j
map <C-k> <C-W>k
map <C-h> <C-W>h
map <C-l> <C-W>l

" 快速清理行尾多余空格
function! StripWhitespace()
  let save_cursor = getpos(".")
  let old_query = getreg('/')
  :%s/\s\+$//e
  call setpos('.', save_cursor)
  call setreg('/', old_query)
endfunction
noremap <leader>ss :call StripWhitespace()<CR>

" 可视模式下按 * 或 # 快速搜索高亮选中内容
vnoremap <silent> * :<C-u>let @/='\V'.escape(@*, '\')<CR>n
vnoremap <silent> # :<C-u>let @/='\V'.escape(@*, '\')<CR>N
