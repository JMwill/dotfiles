"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" JMwill's Lightweight & Robust Vim Configuration
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

" => 基础常规设置
set history=1000
filetype plugin indent on
set autoread
let mapleader=","

" => 用户界面
set scrolloff=7
set wildmenu
set number
set relativenumber
set showmatch
set hlsearch
set incsearch
set ignorecase
set smartcase
set cursorline
set laststatus=2
set showcmd
set title
set shortmess=atI
set belloff=all
set tm=500

" => 主题与真彩色渲染 (优先启用 Vim 9 官方现代旗舰配色 habamax，兼顾经典 desert)
syntax enable
set encoding=utf8
set background=dark
if has("termguicolors")
  set termguicolors
endif

try
  colorscheme habamax
catch
  colorscheme desert
endtry

" 软换行与缩进设置 (2空格缩进标准)
set wrap linebreak nolist
set softtabstop=2
set tabstop=2
set shiftwidth=2
set autoindent
set expandtab

" => 系统与剪贴板设置 (现代 Vim 统一 unnamed 与 unnamedplus)
if has("clipboard")
  set clipboard=unnamed,unnamedplus
endif

set mouse=a

" => 文件备份与跨会话持久撤销 (彻底消除 .swp 弹窗报错，仅保留干净的持久化撤销)
let s:undo_dir = expand('~/.vim/undo')
if !isdirectory(s:undo_dir) | call mkdir(s:undo_dir, 'p') | endif

set undodir=~/.vim/undo
set undofile
set undolevels=1000

" 彻底禁用产生碎片垃圾与弹窗警告的 swap 与 backup 文件
set nobackup
set nowritebackup
set noswapfile

" => 实用快捷键绑定
" 快速保存
nnoremap <leader>w :w!<CR>

" 切换当前工作目录
nnoremap <leader>cd :cd %:p:h<CR>
nnoremap <leader>lcd :lcd %:p:h<CR>

" 空格键快速折叠/展开代码
nnoremap <space> za

" 双手不离主键盘区快速退出编辑模式
inoremap kj <ESC>

" 清理多余高亮
nnoremap <leader>/ :nohlsearch<CR>

" 按视觉行上下移动
nnoremap j gj
nnoremap k gk

" 窗口间流畅跳转
nnoremap <C-j> <C-W>j
nnoremap <C-k> <C-W>k
nnoremap <C-h> <C-W>h
nnoremap <C-l> <C-W>l

" 快速清理行尾多余空格 (保持光标位置与搜索历史)
nnoremap <leader>ss mz:keeppatterns %s/\s\+$//e<CR>`z

" 可视模式下按 * 或 # 快速搜索当前选中文本 (使用专用内部寄存器 v，不污染系统剪贴板)
xnoremap <silent> * "vy/\V<C-R>=escape(@v, '/\')<CR><CR>
xnoremap <silent> # "vy?\V<C-R>=escape(@v, '?\')<CR><CR>

