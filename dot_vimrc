"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" JMwill's Lightweight & Robust Vim Configuration
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

" => 基础常规设置
set history=1000
filetype plugin indent on
set autoread
let mapleader=","

" => 用户界面
set scrolloff=7
set wildmenu
set number
set relativenumber
set showmatch
set hlsearch
set incsearch
set ignorecase
set smartcase
set cursorline
set laststatus=2
set showcmd
set title
set shortmess=atI
set belloff=all
set tm=500

" => 主题与真彩色渲染 (优先启用 Vim 9 官方现代旗舰配色 habamax，兼顾经典 desert)
syntax enable
set encoding=utf8
set background=dark
if has("termguicolors")
  set termguicolors
endif

try
  colorscheme habamax
catch
  colorscheme desert
endtry

" 软换行与缩进设置 (2空格缩进标准)
set wrap linebreak nolist
set softtabstop=2
set tabstop=2
set shiftwidth=2
set autoindent
set expandtab

" => 系统与剪贴板设置 (现代 Vim 统一 unnamed 与 unnamedplus)
if has("clipboard")
  set clipboard=unnamed,unnamedplus
endif

set mouse=a

" => 文件备份与跨会话持久撤销 (彻底消除 .swp 弹窗报错，仅保留干净的持久化撤销)
let s:undo_dir = expand('~/.vim/undo')
if !isdirectory(s:undo_dir) | call mkdir(s:undo_dir, 'p') | endif

set undodir=~/.vim/undo
set undofile
set undolevels=1000

" 彻底禁用产生碎片垃圾与弹窗警告的 swap 与 backup 文件
set nobackup
set nowritebackup
set noswapfile

" => 实用快捷键绑定 (全面对齐 Emacs / redguardtoo / VS Code 统一交互体系)
" 快速保存当前文件 (对齐 Emacs/VSCode 的 ,xs 体系)
nnoremap <leader>xs :w<CR>

" 切换当前工作目录
nnoremap <leader>cd :cd %:p:h<CR>
nnoremap <leader>lcd :lcd %:p:h<CR>

" 复制文件绝对路径与文件名到系统剪贴板 (与 Emacs / VS Code 统一)
nnoremap <leader>fp :let @+=expand("%:p")<CR>:echo "Copied path: " . expand("%:p")<CR>
nnoremap <leader>fn :let @+=expand("%:t")<CR>:echo "Copied file: " . expand("%:t")<CR>

" Emacs / redguardtoo 经典窗口与分屏管理 (与 Emacs / VS Code 统一)
nnoremap <leader>x1 <C-W>o
nnoremap <leader>x2 <C-W>s
nnoremap <leader>x3 <C-W>v
nnoremap <leader>x0 <C-W>c
nnoremap <leader>xk :bd<CR>

" 单文件内搜索 (对齐 Emacs/VSCode 的 ,ss 体系)
nnoremap <leader>ss /

" 快速清理行尾多余空格 (Clean Whitespace)
nnoremap <leader>cw mz:keeppatterns %s/\s\+$//e<CR>`z

" 空格键快速折叠/展开代码 (同时原生支持通用 za)
nnoremap <space> za

" 双手不离主键盘区快速退出编辑模式
inoremap kj <ESC>

" 普通模式下按 Esc 顺手消除搜索高亮 (与现代 IDE 行为对齐，彻底释放与 Emacs 切换中文冲突的 ,/)
nnoremap <silent> <ESC> :nohlsearch<CR><ESC>

" 按视觉行上下移动
nnoremap j gj
nnoremap k gk

" 窗口间流畅跳转 (与 Tmux 风格保持一致)
nnoremap <C-j> <C-W>j
nnoremap <C-k> <C-W>k
nnoremap <C-h> <C-W>h
nnoremap <C-l> <C-W>l

" 可视模式下按 * 或 # 快速搜索当前选中文本 (使用专用内部寄存器 v，不污染系统剪贴板)
xnoremap <silent> * "vy/\V<C-R>=escape(@v, '/\')<CR><CR>
xnoremap <silent> # "vy?\V<C-R>=escape(@v, '?\')<CR><CR>


