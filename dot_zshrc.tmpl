# ==============================================================================
# 10. Conda & Mamba 激活 (动态路径，Termux 自动排除)
# ==============================================================================
if [ -d "{{ .chezmoi.homeDir }}/miniforge3" ]; then
  __conda_setup="$('{{ .chezmoi.homeDir }}/miniforge3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
  if [ $? -eq 0 ]; then
    eval "$__conda_setup"
  elif [ -f "{{ .chezmoi.homeDir }}/miniforge3/etc/profile.d/conda.sh" ]; then
    . "{{ .chezmoi.homeDir }}/miniforge3/etc/profile.d/conda.sh"
  else
    export PATH="{{ .chezmoi.homeDir }}/miniforge3/bin:$PATH"
  fi
  unset __conda_setup

  export MAMBA_EXE='{{ .chezmoi.homeDir }}/miniforge3/bin/mamba'
  export MAMBA_ROOT_PREFIX='{{ .chezmoi.homeDir }}/miniforge3'
  __mamba_setup="$("$MAMBA_EXE" shell hook --shell zsh --root-prefix "$MAMBA_ROOT_PREFIX" 2> /dev/null)"
  if [ $? -eq 0 ]; then
    eval "$__mamba_setup"
  else
    alias mamba="$MAMBA_EXE"
  fi
  unset __mamba_setup
fi
