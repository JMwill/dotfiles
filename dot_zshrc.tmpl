# ==============================================================================
# Termux 后台 SSH 服务管理与防休眠唤醒锁
# ==============================================================================
function ssh-on() {
  sshd 2>/dev/null
  command -v termux-wake-lock &>/dev/null && termux-wake-lock
  local ip
  ip=$(ip route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1)}')
  [ -z "$ip" ] && ip=$(ip -4 addr show wlan0 2>/dev/null | awk '/inet /{print $2}' | cut -d/ -f1)
  [ -z "$ip" ] && ip=$(ifconfig 2>/dev/null | awk '/wlan0:/{flag=1;next}/^[a-z0-9]+:/{flag=0}flag && /inet /{print $2}')
  [ -z "$ip" ] && ip=$(ifconfig 2>/dev/null | awk '/inet /{if($2!="127.0.0.1") print $2}' | tail -n 1)
  [ -z "$ip" ] && ip="<设备IP>"
  local user
  user=$(whoami)
  echo -e "\033[32m✅ SSH 服务已启动 (后台防休眠唤醒锁已开启)\033[0m"
  echo -e "📡 局域网连接 (Wi-Fi): \033[1;36mssh $user@$ip -p 8022\033[0m"
  echo "📝 VS Code Remote-SSH 配置建议:"
  echo "   Host termux"
  echo "       HostName $ip"
  echo "       Port 8022"
  echo "       User $user"
}

function ssh-off() {
  pkill sshd 2>/dev/null
  command -v termux-wake-unlock &>/dev/null && termux-wake-unlock
  echo -e "\033[33m🛑 SSH 服务已停止 (后台唤醒锁已释放)\033[0m"
}
{{ end -}}

{{ if and (ne .chezmoi.os "android") (not (env "TERMUX_VERSION")) -}}
# 3. Node.js (fnm) 环境激活 (非 Termux 环境)
if command -v fnm &> /dev/null; then
  eval "$(fnm env --use-on-cd --shell zsh)"
