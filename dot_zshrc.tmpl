# ==============================================================================
# JMwill's Modern Zsh Configuration (Managed by Chezmoi)
# Multi-platform: Kylin Linux (aarch64) / macOS / Android Termux / Windows WSL
# ==============================================================================

# 1. Powerlevel10k 极速即时提示 (保持在最顶部)
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# 2. 全局基础 PATH 统一收拢
export PATH="$HOME/.local/bin:$HOME/bin:/usr/local/bin:$PATH"

# 3. Node.js (fnm) 环境激活
if command -v fnm &> /dev/null; then
  eval "$(fnm env --use-on-cd --shell zsh)"
elif [ -d "$HOME/.local/share/fnm" ]; then
  export PATH="$HOME/.local/share/fnm:$PATH"
  eval "$(fnm env --use-on-cd --shell zsh)"
fi

# 4. 在 Oh My Zsh 启动前注入自定义补全路径 (彻底消除末尾二次 compinit 造成的卡顿)
if [ -d "$HOME/.local/share/zsh/site-functions" ]; then
  fpath=("$HOME/.local/share/zsh/site-functions" $fpath)
fi

# 5. Oh My Zsh 核心与插件配置
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

plugins=(
  git
  emacs
  autojump
  fzf
  tmux
  zsh-syntax-highlighting
  zsh-autosuggestions
  {{- if eq .chezmoi.os "darwin" }}
  osx
  {{- end }}
  {{- if not (env "TERMUX_VERSION") }}
  conda-zsh-completion
  {{- end }}
)

[[ -f "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

# ==============================================================================
# 6. Zsh 历史记录优化 (兼顾实时同步与防密码泄露)
# ==============================================================================
HISTSIZE=50000
SAVEHIST=50000
setopt EXTENDED_HISTORY          # 记录时间戳
setopt SHARE_HISTORY             # 多终端实时共享命令历史
setopt HIST_IGNORE_DUPS          # 忽略连续重复记录
setopt HIST_IGNORE_SPACE         # 命令开头带空格时不计入历史 (防 Token 泄密)
setopt HIST_REDUCE_BLANKS        # 自动修剪多余空格

# ==============================================================================
# 7. 核心别名与兼容性回退
# ==============================================================================
alias fli='alias | fzf' # 模糊搜索现有别名

# fd-find 兼容性别名 (适配 Debian/Ubuntu)
if command -v fdfind &> /dev/null && ! command -v fd &> /dev/null; then
  alias fd=fdfind
fi

# batcat 兼容性别名 (适配 Debian/Ubuntu/WSL)
if command -v batcat &> /dev/null && ! command -v bat &> /dev/null; then
  alias bat=batcat
fi

{{ if env "WSL_DISTRO_NAME" -}}
# WSL 专有支持：直接调用 Windows 资源管理器/浏览器
alias open="explorer.exe"
{{ end -}}

# ==============================================================================
# 8. 终端代理控制体系 (智能识别端口/主机，大小写全覆盖)
# ==============================================================================
function tproxy() {
  local host="127.0.0.1"
  local port="7890"

  # 智能解析：单参数且全数字则识别为端口 (如 tproxy 10808)
  if [[ $# -eq 1 ]]; then
    if [[ "$1" =~ ^[0-9]+$ ]]; then
      port="$1"
    else
      host="$1"
    fi
  elif [[ $# -ge 2 ]]; then
    host="$1"
    port="$2"
  fi

  local proxy_url="http://${host}:${port}"
  local socks_url="socks5://${host}:${port}"

  export http_proxy="$proxy_url"
  export https_proxy="$proxy_url"
  export all_proxy="$socks_url"
  export HTTP_PROXY="$proxy_url"
  export HTTPS_PROXY="$proxy_url"
  export ALL_PROXY="$socks_url"
  export NODE_USE_ENV_PROXY=1

  # 通用本地直连白名单 (单位内网专属白名单配置在 ~/.zshrc.local)
  export NO_PROXY="localhost,127.0.0.1"
  export no_proxy="localhost,127.0.0.1"

  echo -e "\033[32m✔ 终端代理已开启: ${proxy_url}\033[0m"
}

function tunproxy() {
  unset http_proxy https_proxy all_proxy
  unset HTTP_PROXY HTTPS_PROXY ALL_PROXY
  unset NODE_USE_ENV_PROXY
  echo -e "\033[33m✖ 终端代理已关闭.\033[0m"
}

function tproxystatus() {
  if [[ -n "$http_proxy" || -n "$HTTP_PROXY" ]]; then
    echo -e "\033[32m✔ 代理状态: 开启中\033[0m (${http_proxy:-$HTTP_PROXY})"
  else
    echo -e "\033[33m✖ 代理状态: 未开启\033[0m"
  fi
}

# ==============================================================================
# 9. 高频 Git 与跨平台剪贴板辅助函数
# ==============================================================================
# 极速获取 Commit 的 GitHub 网页链接 (不传参数默认取 HEAD 最新提交)
function gurl() {
  local remote_url
  remote_url=$(git config --get remote.origin.url 2>/dev/null) || { echo "Not a git repo or no origin remote." >&2; return 1; }
  local repo_path="${${remote_url#*github.com[:/]}%.git}"
  echo "https://github.com/${repo_path}/commit/${1:-$(git rev-parse HEAD)}"
}

# 交互式挑选 commit id
function gcid() {
  git log --pretty=format:'%h %ad %s (%an)' --date=short | fzf | awk '{print $1}'
}

# 交互式挑 commit 并输出 GitHub 网页链接
function gqurl() {
  local commit_id
  commit_id=$(gcid)
  [[ -n "$commit_id" ]] && gurl "$commit_id"
}

# 跨平台剪贴板复制 (编译期适配对应平台，运行时零额外开销)
function pclip() {
  {{- if eq .chezmoi.os "darwin" }}
  printf "%s" "${*:-$(cat)}" | pbcopy
  {{- else if env "WSL_DISTRO_NAME" }}
  printf "%s" "${*:-$(cat)}" | clip.exe
  {{- else if env "TERMUX_VERSION" }}
  if command -v termux-clipboard-set &>/dev/null; then
    printf "%s" "${*:-$(cat)}" | termux-clipboard-set
  fi
  {{- else }}
  if command -v xclip &>/dev/null; then
    printf "%s" "${*:-$(cat)}" | xclip -selection clipboard -i
  elif command -v xsel &>/dev/null; then
    printf "%s" "${*:-$(cat)}" | xsel -ib
  elif command -v wl-copy &>/dev/null; then
    printf "%s" "${*:-$(cat)}" | wl-copy
  fi
  {{- end }}
}

# 跨平台剪贴板粘贴
function ppaste() {
  {{- if eq .chezmoi.os "darwin" }}
  pbpaste
  {{- else if env "WSL_DISTRO_NAME" }}
  powershell.exe -NoProfile -Command Get-Clipboard | tr -d '\r'
  {{- else if env "TERMUX_VERSION" }}
  command -v termux-clipboard-get &>/dev/null && termux-clipboard-get
  {{- else }}
  if command -v xclip &>/dev/null; then
    xclip -selection clipboard -o
  elif command -v xsel &>/dev/null; then
    xsel --clipboard --output
  elif command -v wl-paste &>/dev/null; then
    wl-paste
  fi
  {{- end }}
}

# fzf 文件路径查找并自动复制到剪贴板 (优先调用极速 fd)
function ff() {
  local cli
  if command -v fd &>/dev/null; then
    cli=$(fd --type f --hidden --exclude .git 2>/dev/null | fzf)
  elif command -v fdfind &>/dev/null; then
    cli=$(fdfind --type f --hidden --exclude .git 2>/dev/null | fzf)
  else
    cli=$(find . -not -iwholename '*/.git*' -not -iwholename '*/node_modules/*' -type f 2>/dev/null | fzf)
  fi

  if [ -n "$cli" ]; then
    local full_path
    full_path="$(cd "$(dirname "$cli")" || exit; pwd)/$(basename "$cli")"
    full_path="${full_path/#$HOME/~}"
    echo "$full_path"
    pclip "$full_path"
  fi
}

{{ if not (env "TERMUX_VERSION") -}}
# ==============================================================================
# 10. Conda & Mamba 激活 (动态路径，Termux 自动排除)
# ==============================================================================
if [ -d "{{ .chezmoi.homeDir }}/miniforge3" ]; then
  __conda_setup="$('{{ .chezmoi.homeDir }}/miniforge3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
  if [ $? -eq 0 ]; then
    eval "$__conda_setup"
  elif [ -f "{{ .chezmoi.homeDir }}/miniforge3/etc/profile.d/conda.sh" ]; then
    . "{{ .chezmoi.homeDir }}/miniforge3/etc/profile.d/conda.sh"
  else
    export PATH="{{ .chezmoi.homeDir }}/miniforge3/bin:$PATH"
  fi
  unset __conda_setup

  export MAMBA_EXE='{{ .chezmoi.homeDir }}/miniforge3/bin/mamba'
  export MAMBA_ROOT_PREFIX='{{ .chezmoi.homeDir }}/miniforge3'
  __mamba_setup="$("$MAMBA_EXE" shell hook --shell zsh --root-prefix "$MAMBA_ROOT_PREFIX" 2> /dev/null)"
  if [ $? -eq 0 ]; then
    eval "$__mamba_setup"
  else
    alias mamba="$MAMBA_EXE"
  fi
  unset __mamba_setup
fi
{{ end -}}

# 11. 加载 Powerlevel10k 主题自定义配置
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# 12. 本地私有逃生舱 (存放公司专属环境变量、内网域名等，不入 Git 仓库)
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
