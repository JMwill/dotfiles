# 4. 在 Oh My Zsh 启动前注入自定义补全路径 (彻底消除末尾二次 compinit 造成的卡顿)
if [ -d "$HOME/.local/share/zsh/site-functions" ]; then
  fpath=("$HOME/.local/share/zsh/site-functions" $fpath)
fi

# 5. Oh My Zsh 核心与插件配置
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

plugins=(
  git
  emacs
  chezmoi
  fzf
  tmux
  zsh-syntax-highlighting
  zsh-autosuggestions
  {{- if eq .chezmoi.os "darwin" }}
  osx
  {{- end }}
)

[[ -f "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

# ==============================================================================
# 6. Zsh 历史记录优化 (兼顾实时同步与防密码泄露)
# ==============================================================================
HISTSIZE=50000
SAVEHIST=50000
setopt EXTENDED_HISTORY          # 记录时间戳
setopt SHARE_HISTORY             # 多终端实时共享命令历史
setopt HIST_IGNORE_DUPS          # 忽略连续重复记录
setopt HIST_IGNORE_SPACE         # 命令开头带空格时不计入历史 (防 Token 泄密)
setopt HIST_REDUCE_BLANKS        # 自动修剪多余空格

# ==============================================================================
# 7. 核心别名与兼容性回退
# ==============================================================================
alias fli='alias | fzf' # 模糊搜索现有别名
alias '。。'='..'       # 中文输入法全角句号智能容错 (自动转为 cd ..)

# uv / uvx 自动补全 (若 site-functions 未命中则动态加载)
if command -v uv &> /dev/null; then
  if [ ! -f "$HOME/.local/share/zsh/site-functions/_uv" ]; then
    eval "$(uv generate-shell-completion zsh)"
    eval "$(uvx --generate-shell-completion zsh)"
  fi
fi

# fd-find 兼容性别名 (适配 Debian/Ubuntu，0 毫秒内部哈希直查)
if (( $+commands[fdfind] )) && (( ! $+commands[fd] )); then
  alias fd=fdfind
fi

# batcat 兼容性别名 (适配 Debian/Ubuntu/WSL)
if (( $+commands[batcat] )) && (( ! $+commands[bat] )); then
  alias bat=batcat
fi

# zoxide (替代 autojump 的全平台极速目录跳转，保留 j 与 ji 交互式跳转)
if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh --cmd j)"
fi

{{ if env "WSL_DISTRO_NAME" -}}
# WSL 专有支持：直接调用 Windows 资源管理器/浏览器
alias open="explorer.exe"
{{ end -}}

# ==============================================================================
# 8. 终端代理控制体系 (智能识别端口/主机，大小写全覆盖)
# ==============================================================================
function tproxy() {
  local host="127.0.0.1"
  local port="7890"

  # 智能解析：支持 "tproxy 10808"、"tproxy 192.168.1.5"、"tproxy 192.168.1.5 10808"、"tproxy 192.168.1.5:10808"
  if [[ $# -eq 1 ]]; then
    if [[ "$1" =~ ^[0-9]+$ ]]; then
      port="$1"
    elif [[ "$1" == *:* ]]; then
      host="${1%:*}"
      port="${1##*:}"
    else
      host="$1"
    fi
  elif [[ $# -ge 2 ]]; then
    host="$1"
    port="$2"
  fi

  local proxy_url="http://${host}:${port}"
  local socks_url="socks5://${host}:${port}"

  export http_proxy="$proxy_url"
  export https_proxy="$proxy_url"
  export all_proxy="$socks_url"
  export HTTP_PROXY="$proxy_url"
  export HTTPS_PROXY="$proxy_url"
  export ALL_PROXY="$socks_url"
  export NODE_USE_ENV_PROXY=1

  # 通用本地直连白名单 (智能保留既有白名单如 ~/.zshrc.local 中配置的单位内网域名)
  local default_no_proxy="localhost,127.0.0.1"
  if [[ -n "$NO_PROXY" ]]; then
    if [[ "$NO_PROXY" != *"127.0.0.1"* ]]; then
      export NO_PROXY="${NO_PROXY},${default_no_proxy}"
    fi
  else
    export NO_PROXY="$default_no_proxy"
  fi
  export no_proxy="$NO_PROXY"

  echo -e "\033[32m✔ 终端代理已开启: ${proxy_url}\033[0m"
}

function tunproxy() {
  unset http_proxy https_proxy all_proxy
  unset HTTP_PROXY HTTPS_PROXY ALL_PROXY
  unset NODE_USE_ENV_PROXY
  echo -e "\033[33m✖ 终端代理已关闭.\033[0m"
}

function tproxystatus() {
  if [[ -n "$http_proxy" || -n "$HTTP_PROXY" ]]; then
    echo -e "\033[32m✔ 代理状态: 开启中\033[0m (${http_proxy:-$HTTP_PROXY})"
  else
    echo -e "\033[33m✖ 代理状态: 未开启\033[0m"
  fi
}

# ==============================================================================
# 9. 高频 Git 与跨平台剪贴板辅助函数
# ==============================================================================
# 极速获取 Commit 的网页链接 (支持 GitHub, GitLab, Gitee 及单位内网 GitLab)
function gurl() {
  local remote_url
  remote_url=$(git config --get remote.origin.url 2>/dev/null) || { echo "Not a git repo or no origin remote." >&2; return 1; }
  local commit_hash="${1:-$(git rev-parse HEAD 2>/dev/null)}" || { echo "No commits yet." >&2; return 1; }

  local host path
  if [[ "$remote_url" =~ ^git@([^:]+):(.+)\.git$ ]]; then
    host="${match[1]}"
    path="${match[2]}"
  elif [[ "$remote_url" =~ ^https?://([^/]+)/(.+)\.git$ ]]; then
    host="${match[1]}"
    path="${match[2]}"
  elif [[ "$remote_url" =~ ^https?://([^/]+)/(.+)$ ]]; then
    host="${match[1]}"
    path="${match[2]}"
  else
    local repo_path="${${remote_url#*github.com[:/]}%.git}"
    echo "https://github.com/${repo_path}/commit/${commit_hash}"
    return 0
  fi

  echo "https://${host}/${path}/commit/${commit_hash}"
}

# 交互式挑选 commit id
function gcid() {
  git log --pretty=format:'%h %ad %s (%an)' --date=short | fzf | awk '{print $1}'
}

# 交互式挑 commit 并输出 GitHub 网页链接
function gqurl() {
  local commit_id
  commit_id=$(gcid)
  [[ -n "$commit_id" ]] && gurl "$commit_id"
}

# 跨平台剪贴板复制 (编译期适配对应平台，运行时零额外开销)
function pclip() {
  {{- if eq .chezmoi.os "darwin" }}
  printf "%s" "${*:-$(cat)}" | pbcopy
  {{- else if env "WSL_DISTRO_NAME" }}
  printf "%s" "${*:-$(cat)}" | clip.exe
  {{- else if or (eq .chezmoi.os "android") (env "TERMUX_VERSION") }}
  if command -v termux-clipboard-set &>/dev/null; then
    printf "%s" "${*:-$(cat)}" | termux-clipboard-set
  fi
  {{- else }}
  if command -v xclip &>/dev/null; then
    printf "%s" "${*:-$(cat)}" | xclip -selection clipboard -i
  elif command -v xsel &>/dev/null; then
    printf "%s" "${*:-$(cat)}" | xsel -ib
  elif command -v wl-copy &>/dev/null; then
    printf "%s" "${*:-$(cat)}" | wl-copy
  fi
  {{- end }}
}

# 跨平台剪贴板粘贴
function ppaste() {
  {{- if eq .chezmoi.os "darwin" }}
  pbpaste
  {{- else if env "WSL_DISTRO_NAME" }}
  powershell.exe -NoProfile -Command Get-Clipboard | tr -d '\r'
  {{- else if or (eq .chezmoi.os "android") (env "TERMUX_VERSION") }}
  command -v termux-clipboard-get &>/dev/null && termux-clipboard-get
  {{- else }}
  if command -v xclip &>/dev/null; then
    xclip -selection clipboard -o
  elif command -v xsel &>/dev/null; then
    xsel --clipboard --output
  elif command -v wl-paste &>/dev/null; then
    wl-paste
  fi
  {{- end }}
}

# fzf 文件路径查找并自动复制到剪贴板 (优先调用极速 fd/fdfind)
function ff() {
  local cli
  local fd_bin=""
  if (( $+commands[fd] )); then
    fd_bin="fd"
  elif (( $+commands[fdfind] )); then
    fd_bin="fdfind"
  fi

  if [[ -n "$fd_bin" ]]; then
    cli=$("$fd_bin" --type f --hidden --exclude .git 2>/dev/null | fzf -q "${*:-}")
  else
    cli=$(find . -not -iwholename '*/.git*' -not -iwholename '*/node_modules/*' -type f 2>/dev/null | fzf -q "${*:-}")
  fi

  if [ -n "$cli" ]; then
    local full_path
    full_path="$(cd "$(dirname "$cli")" || exit; pwd)/$(basename "$cli")"
    full_path="${full_path/#$HOME/~}"
    echo "$full_path"
    pclip "$full_path"
  fi
}

