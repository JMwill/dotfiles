{{ if or (eq .chezmoi.os "android") (env "TERMUX_VERSION") -}}
#!/data/data/com.termux/files/usr/bin/env bash
{{ else -}}
#!/usr/bin/env bash
{{ end -}}
set -euo pipefail

echo "=================================================="
echo ">>> 开始检查并自动补全系统基础依赖..."
echo "=================================================="

# 1. 平台原生包管理器安装
{{ if eq .chezmoi.os "darwin" -}}
# ==================== macOS ====================
if command -v brew &>/dev/null; then
  MISSING_BREW=()
  for pkg in zsh tmux git fzf zoxide fd ripgrep bat croc fnm uv; do
    brew list "$pkg" &>/dev/null || MISSING_BREW+=("$pkg")
  done
  if [ ${#MISSING_BREW[@]} -gt 0 ]; then
    echo ">>> [macOS] 正在通过 Homebrew 安装缺失软件: ${MISSING_BREW[*]}..."
    brew install "${MISSING_BREW[@]}"
  else
    echo ">>> [macOS] Homebrew 基础软件已全部就绪，跳过安装。"
  fi
else
  echo ">>> [警告] 未检测到 Homebrew，请先安装 brew 后重新执行 chezmoi apply"
fi

{{ else if or (eq .chezmoi.os "android") (env "TERMUX_VERSION") -}}
# ==================== Android Termux ====================
MISSING_TERMUX=()
for pkg in zsh tmux git curl fzf zoxide fd ripgrep bat termux-api croc uv; do
  command -v "$pkg" &>/dev/null || MISSING_TERMUX+=("$pkg")
done
if [ ${#MISSING_TERMUX[@]} -gt 0 ]; then
  echo ">>> [Termux] 正在通过 pkg 安装缺失软件: ${MISSING_TERMUX[*]}..."
  pkg update -y
  pkg install -y "${MISSING_TERMUX[@]}"
else
  echo ">>> [Termux] 基础软件已全部就绪，跳过安装。"
fi

{{ else if eq .chezmoi.os "linux" -}}
# ==================== 银河麒麟 / Debian / Ubuntu / WSL ====================
MISSING_PKGS=()
for pkg in zsh tmux git curl fzf {{ if not (env "WSL_DISTRO_NAME") }}xclip{{ end }}; do
  command -v "$pkg" &>/dev/null || MISSING_PKGS+=("$pkg")
done
command -v fdfind &>/dev/null || command -v fd &>/dev/null || MISSING_PKGS+=("fd-find")
command -v rg &>/dev/null || MISSING_PKGS+=("ripgrep")
command -v bat &>/dev/null || command -v batcat &>/dev/null || MISSING_PKGS+=("bat")

if [ ${#MISSING_PKGS[@]} -gt 0 ]; then
  echo ">>> [Linux 桌面/WSL] 检测到缺失依赖: ${MISSING_PKGS[*]}，正在通过 apt 安装..."
  sudo apt update -y || true
  sudo apt install -y "${MISSING_PKGS[@]}"
else
  echo ">>> [Linux 桌面/WSL] 系统基础依赖已全部就绪，跳过 apt 安装。"
fi

# 安装 croc (若未安装)
if ! command -v croc &>/dev/null; then
  echo ">>> 正在安装 croc (跨端加密快传工具)..."
  curl -fsSL https://getcroc.schollz.com | bash
fi

# 安装 uv (Astral 极速 Python 项目与包管理器)
if ! command -v uv &>/dev/null; then
  echo ">>> 正在安装 uv (Fast Python Package Manager)..."
  curl -fsSL https://astral.sh/uv/install.sh | bash
fi

# 安装 zoxide (若系统包管理器未收录，使用官方预编译脚本安装至 ~/.local/bin)
if ! command -v zoxide &>/dev/null && [ ! -f "$HOME/.local/bin/zoxide" ]; then
  echo ">>> 正在安装 zoxide (极速目录跳转工具)..."
  if command -v apt-get &>/dev/null && apt-cache show zoxide &>/dev/null; then
    sudo apt install -y zoxide
  else
    curl -sSfL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | sh
  fi
fi
{{ end -}}

{{ if and (ne .chezmoi.os "android") (not (env "TERMUX_VERSION")) -}}
# 安装 fnm (Node.js 极速版本管理器，非 Termux 环境通用)
if ! command -v fnm &>/dev/null && [ ! -f "$HOME/.local/share/fnm/fnm" ]; then
  echo ">>> 正在安装 fnm (Fast Node Manager)..."
  curl -fsSL https://fnm.vercel.app/install | bash -s -- --skip-shell
fi
{{ end -}}

# 2. Oh My Zsh 核心安装 (若未安装，支持 GitHub 失败时自动通过 Gitee 镜像降级)
if [ ! -d "$HOME/.oh-my-zsh" ]; then
  echo ">>> 正在安装 Oh My Zsh..."
  if ! (RUNZSH=no CHSH=no KEEP_ZSHRC=yes sh -c "$(curl -fsSL --connect-timeout 5 https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" 2>/dev/null); then
    echo ">>> [提示] GitHub 直连受阻，尝试通过 Gitee 国内镜像安装 Oh My Zsh..."
    git clone https://gitee.com/mirrors/oh-my-zsh.git "$HOME/.oh-my-zsh" || true
  fi
fi

ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"

# 3. 自动拉取自定义插件与主题 (全平台通用，支持 Gitee 镜像容错)
if [ ! -d "$ZSH_CUSTOM/themes/powerlevel10k" ]; then
  echo ">>> 正在克隆 Powerlevel10k 主题..."
  git clone --depth=1 https://github.com/romkatv/powerlevel10k.git "$ZSH_CUSTOM/themes/powerlevel10k" 2>/dev/null || \
  git clone --depth=1 https://gitee.com/romkatv/powerlevel10k.git "$ZSH_CUSTOM/themes/powerlevel10k" || true
fi

if [ ! -d "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting" ]; then
  echo ">>> 正在克隆 zsh-syntax-highlighting 插件..."
  git clone https://github.com/zsh-users/zsh-syntax-highlighting "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting" 2>/dev/null || \
  git clone https://gitee.com/zsh-users/zsh-syntax-highlighting "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting" || true
fi

if [ ! -d "$ZSH_CUSTOM/plugins/zsh-autosuggestions" ]; then
  echo ">>> 正在克隆 zsh-autosuggestions 插件..."
  git clone https://github.com/zsh-users/zsh-autosuggestions "$ZSH_CUSTOM/plugins/zsh-autosuggestions" 2>/dev/null || \
  git clone https://gitee.com/zsh-users/zsh-autosuggestions "$ZSH_CUSTOM/plugins/zsh-autosuggestions" || true
fi


# 4. 生成 uv / uvx 补全定义文件 (全平台极速懒加载)
if command -v uv &>/dev/null || [ -f "$HOME/.local/bin/uv" ]; then
  UV_BIN="$(command -v uv || echo "$HOME/.local/bin/uv")"
  mkdir -p "$HOME/.local/share/zsh/site-functions"
  "$UV_BIN" generate-shell-completion zsh > "$HOME/.local/share/zsh/site-functions/_uv" 2>/dev/null || true
  if command -v uvx &>/dev/null || [ -f "$HOME/.local/bin/uvx" ]; then
    UVX_BIN="$(command -v uvx || echo "$HOME/.local/bin/uvx")"
    "$UVX_BIN" --generate-shell-completion zsh > "$HOME/.local/share/zsh/site-functions/_uvx" 2>/dev/null || true
  fi
fi

# 5. 自动补全 VS Code / Cursor 核心扩展 (若系统已安装对应 IDE)
for cli in code cursor; do
  if command -v "$cli" &>/dev/null; then
    installed_exts=$("$cli" --list-extensions 2>/dev/null || true)
    for ext in vscodevim.vim ms-vscode-remote.remote-ssh; do
      if ! echo "$installed_exts" | grep -qi "^${ext}$"; then
        echo ">>> [$cli] 正在安装核心扩展: $ext..."
        "$cli" --install-extension "$ext" 2>/dev/null || true
      fi
    done
  fi
done

echo "=================================================="
echo "✔ 所有基础依赖与插件就绪！即将部署配置文件..."
echo "=================================================="
