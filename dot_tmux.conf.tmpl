# 终端真彩色与历史回滚支持
set -g default-terminal "xterm-256color"
set -as terminal-overrides ",xterm-256color:Tc"
set -g history-limit 50000

# 消除 Vim / Neovim 退出插入模式的 500ms 滞后延迟 (10ms 黄金平衡值)
set -s escape-time 10

# 鼠标支持与 Vi 模式
set -g mouse on
setw -g mode-keys vi

# 窗口与窗格编号从 1 开始 (符合键盘手势)
set -g base-index 1
setw -g pane-base-index 1

# 自动重命名与自动重排编号
setw -g automatic-rename on
set -g renumber-windows on

# 面板分割绑定 (保持当前工作目录)
unbind '"'
unbind %
bind - split-window -v -c "#{pane_current_path}"
bind | split-window -h -c "#{pane_current_path}"

# Vi 风格面板导航
bind k select-pane -U
bind j select-pane -D
bind h select-pane -L
bind l select-pane -R

# 一键热重载配置
bind r source-file ~/.tmux.conf \; display-message "✔ ~/.tmux.conf reloaded!"

# 复制模式与多端跨平台剪贴板
bind-key -T copy-mode-vi v send -X begin-selection
bind-key -T copy-mode-vi 'C-v' send -X rectangle-toggle

{{- $clip := "xclip -se c -i" -}}
{{- if eq .chezmoi.os "darwin" -}}
  {{- $clip = "pbcopy" -}}
{{- else if env "WSL_DISTRO_NAME" -}}
  {{- $clip = "clip.exe" -}}
{{- else if or (eq .chezmoi.os "android") (env "TERMUX_VERSION") -}}
  {{- $clip = "termux-clipboard-set" -}}
{{- end }}
bind-key -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "{{ $clip }}"
bind-key -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel "{{ $clip }}"
bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "{{ $clip }}"
